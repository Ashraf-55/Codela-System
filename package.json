{
  "name": "codela",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @codela/api",
    "dev:web": "npm run dev -w @codela/web",
    "build": "npm run build -w @codela/web",
    "start:api": "npm run start -w @codela/api",
    "start:web": "npm run start -w @codela/web",
    "create-admin": "npm run create-admin -w @codela/api",
    "db:generate": "npm run generate -w @codela/db",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.base.json && npm run typecheck -w @codela/web",
    "smoke": "bash scripts/smoke.sh",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "backup": "npm run backup -w @codela/api",
    "audit:prod": "npm audit --omit=dev --registry=https://registry.npmjs.org"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
