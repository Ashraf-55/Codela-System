# ───────── Codela — environment (copy to .env; NEVER commit real values) ─────────
# API (read from <repo>/.env by apps/api)
NODE_ENV=development            # production => secure cookies, sandbox billing OFF unless PAYMENT_PROVIDER=sandbox
PORT=4000
DATABASE_FILE=./data/codela.db  # SQLite file (relative paths are resolved from the repo root)
CSRF_SECRET=change-me-to-a-long-random-string   # REQUIRED in production (>= 32 random chars)
ROOT_DOMAIN=localhost           # tenant sites are served at <slug>.<ROOT_DOMAIN>
TRUST_PROXY=loopback            # who may set X-Forwarded-*: 'loopback' (default; Next.js on the same machine), a hop count (1 = one reverse proxy), or proxy IPs/CIDRs. NEVER 'true'/'*' (spoofable -> rate-limit bypass; the API refuses to start)

# Payments (see docs/SUBSCRIPTION_SYSTEM.md). Leave empty in production until a real provider is integrated.
# PAYMENT_PROVIDER=             # leave EMPTY in production = manual InstaPay / Vodafone Cash only (customers upload a receipt, Super Admin approves).
#                               # sandbox = DEV ONLY: NO real money, add-ons and upgrades are granted for free. Never set it on a live server.
PAYMENT_PROVIDER=sandbox        # dev default; delete this line (or set NODE_ENV=production) for real customers
SANDBOX_WEBHOOK_SECRET=         # HMAC secret used to sign sandbox webhooks
PAYMOB_API_KEY=                 # live Paymob integration is NOT implemented yet; the variable is only checked for presence

# Admin bootstrap (used only by `npm run create-admin`; do not keep in .env afterwards)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Super Admin

# Web (Next.js) — put these in apps/web/.env.local
# API_URL=http://127.0.0.1:4000
# ROOT_DOMAIN=localhost
# WEB_TRUST_PROXY_HOPS=0          # reverse proxies in front of Next.js (0 = none; 1 = Caddy/nginx/Cloudflare). The client IP is taken from the Nth X-Forwarded-For entry from the right
# WEB_HOSTS=localhost,127.0.0.1   # hosts that serve the Codela product itself; any other host is treated as a tenant website

# ---- Payments: Paymob (PAYMENT_PROVIDER=paymob) — see docs/PAYMENTS.md ----
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID=          # card integration id (number)
# PAYMOB_IFRAME_ID=               # iframe id (number)
# PAYMOB_HMAC_SECRET=             # from Paymob dashboard; verifies the processed-callback HMAC
# Callback URL to set in Paymob: https://<api-host>/api/v1/webhooks/paymob

# ---- Notifications — see docs/NOTIFICATIONS.md (a channel without credentials reports status "no_provider", never "sent") ----
# RESEND_API_KEY=
# EMAIL_FROM=Codela <no-reply@your-domain>
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx        # number or Messaging Service SID (MG...)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=         # approved template for business-initiated messages
# WHATSAPP_TEMPLATE_LANG=ar

# ---- Uploads & portal ----
# UPLOAD_DIR=data/uploads         # private on-disk storage (back it up; keep it OUTSIDE any web root)
# PORTAL_REQUIRE_EMAIL_VERIFICATION=1   # default: on in production. NEVER disable in production: records are linked to portal accounts by e-mail

# ---- Added in the third/fourth pass ----
# PUBLIC_API_URL=https://api.your-domain.com      # used for Twilio delivery receipts (StatusCallback) — must match the URL Twilio calls exactly
# PUBLIC_WEB_URL=https://your-domain.com          # used in renewal e-mails ("renew from Billing")
# WHATSAPP_VERIFY_TOKEN=                          # webhook handshake for WhatsApp delivery receipts: https://<api>/api/v1/webhooks/whatsapp
# WHATSAPP_APP_SECRET=                            # signs those callbacks (X-Hub-Signature-256)
# CSP_STRICT=0                                    # 1 = nonce-based script CSP in the web app (test every page first)
# BACKUP_DIR=data/backups
# BACKUP_KEEP=14

# ---- Fifth pass: account recovery, e-mail receipts, monitoring ----
# PUBLIC_WEB_URL (above) is also the host used in the verification / password-reset links e-mailed to owners and staff (/recover?reset=…, /recover?verify=…). Set it in production.
# STAFF_EMAIL_VERIFICATION=1            # send a verification e-mail when a business registers. Default: on in production, off in development/tests
# STAFF_REQUIRE_EMAIL_VERIFICATION=0    # 1 = owners/staff cannot log in until they confirm the e-mail (existing accounts are back-filled as verified by migration 0013). Default off
# RESEND_WEBHOOK_SECRET=                # whsec_… from Resend > Webhooks; receipts endpoint: https://<api>/api/v1/webhooks/resend (events: email.sent, email.delivered, email.bounced, email.complained)
# SENTRY_DSN=                           # any Sentry-compatible DSN (Sentry, GlitchTip). Empty = monitoring off. Sends error type, scrubbed message, stack, method and path only
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=

# ---- Sixth pass: hosted lesson videos, E2E ----
# Lesson videos (MP4 / WebM, up to 150 MB) are streamed to UPLOAD_DIR/<tenant>/ (never held in memory by the API). Behind a reverse proxy raise its body limit
# to >= 160 MB for /api/v1/tenant/files/video (nginx: client_max_body_size 160m;). The Next.js app already allows 160 MB (next.config.mjs proxyClientMaxBodySize).
# Browser tests only (ignored when NODE_ENV=production): NEVER set these on a real server.
# E2E_RELAX_RATE_LIMITS=1         # API: lifts the per-IP auth / public-form limiters so ~100 throw-away registrations can run in minutes
# E2E_CHROMIUM_PATH=/path/to/chrome   # Playwright: use an already-installed Chromium instead of downloading one
# E2E_NO_VIDEO=1                  # Playwright: skip failure videos (they need ffmpeg)
# E2E_ADMIN_EMAIL= / E2E_ADMIN_PASSWORD=   # enables the Super Admin spec (create the admin first with `npm run create-admin`)
