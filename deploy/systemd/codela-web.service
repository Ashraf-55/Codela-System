[Unit]
Description=Codela web (Next.js)
After=network.target codela-api.service
Wants=codela-api.service

[Service]
Type=simple
User=codela
WorkingDirectory=/opt/codela
Environment=NODE_ENV=production API_URL=http://127.0.0.1:4000 WEB_TRUST_PROXY_HOPS=1
EnvironmentFile=-/opt/codela/apps/web/.env.local
ExecStart=/usr/bin/npm run start:web
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
